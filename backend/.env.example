# Environment Configuration for TOPS Backend
# Copy this file to .env and customize values as needed
# All variables are optional and have sensible defaults
# Only TOPS_* prefixed variables are read by the backend

# CORS Origins (comma-separated list of allowed origins)
# Required when running frontend dev server separately
# TOPS_CORS_ORIGINS=http://localhost:3000

# Hardware Device Identifiers (only needed with hardware)
# TOPS_STAGE_SERIAL=103387864
# TOPS_MULTIMETER_SERIAL=W114239033
# TOPS_LOCKIN_PID=3769

# Thorlabs Kinesis Installation Path (Windows only)
# TOPS_THORLABS_KINESIS_PATH=C:\Program Files\Thorlabs\Kinesis

# Data Directory (for storing measurement data files)
# TOPS_DATA_DIRECTORY=./data
