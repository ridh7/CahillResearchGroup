{
  "frontend/**/*.{js,jsx,ts,tsx}": [
    "bash -c 'cd frontend/tops-2.0-measurement-system && npx eslint --fix \"$@\"' --",
    "bash -c 'cd frontend/tops-2.0-measurement-system && npx prettier --write \"$@\"' --"
  ],
  "frontend/**/*.{json,md,css}": [
    "bash -c 'cd frontend/tops-2.0-measurement-system && npx prettier --write \"$@\"' --"
  ],
  "backend/**/*.py": [
    "backend/myenv/Scripts/python.exe -m ruff format",
    "backend/myenv/Scripts/python.exe -m ruff check --fix"
  ]
}
